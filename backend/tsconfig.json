{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		/* Basic Options */
		"lib": ["ES2022"],
		"target": "ES2022",
		"module": "ES2022",
		"types": ["node"],
		"paths": {},

		/* Workspace Settings */
		"composite": true,

		/* Strict Type-Checking Options */
		"strict": true,

		/* Module Resolution Options */
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true,
		"sourceMap": true,

		"declaration": true,

		/* Advanced Options */
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"include": ["server.ts", "interns.ts", "db/**/*.ts", "shared/**/*.ts", "shared/**/*.d.ts"]
}
